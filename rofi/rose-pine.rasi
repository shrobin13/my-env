
/*
 * Rose Pine Glass — Material Layout (Improved)
 */

* {
    spacing: 0;
    background-color: transparent;
}

/* --------------------------------------------------------------------- */
/* Window                                                                */
/* --------------------------------------------------------------------- */
window {
    transparency: "real";
    background-color: rgba(90,80,80,0.20);   /* semi-glass overlay */
    border: 1px;
    border-color: rgba(90,120,120,1);
     /* iris glow */
    border-radius: 4px;
    padding: 15px;
}

/* --------------------------------------------------------------------- */
/* Main Layout                                                           */
/* --------------------------------------------------------------------- */
mainbox {
    children: [inputbar, message, mode-switcher, listview];
    spacing: 10px;
    padding: 10px 0;
    border: 0;
    background-color: transparent;
}

/* ── Search bar ─────────────────────────────────────────────────────── */
inputbar {
    padding: 5px 18px;
    background-color: rgba(90,50,60,0.3);
  /* surface */
    border-radius: 4px;
    children: [prompt, textbox-prompt-colon, entry, case-indicator];
}

prompt {
    text-color: #9ccfd8; /* foam */
}

textbox-prompt-colon {
    expand: false;
    str: "  ";
    margin: 0 10px 0 0;
    text-color: #9ccfd8;
}

entry {
    background-color: transparent;
    text-color: #e0def4;   /* bright text */
    placeholder: "Search…";
}

case-indicator {
    text-color: #eb6f92; /* love */
}

/* ── Mode switcher & messages ───────────────────────────────────────── */
mode-switcher, message {
    border: 0;
    padding: 4px;
    spacing: 6px; 
    border-radius: 6px;
    background-color: rgba(50,60,60,0.5);
    text-color: #e0def4;
}

error-message {
    background-color: #eb6f92;
    border-radius: 6px;
    padding: 6px;
    text-color: #1c1928;
}

/* ── Buttons ────────────────────────────────────────────────────────── */
button, textbox {
    text-color: #e0def4;
    padding: 5px 10px;
    border-radius: 4px;
}

button selected {
	  background-color: rgba(50,120,120,0.7);
    text-color:  #FFFF;
}

/* ── Result list ────────────────────────────────────────────────────── */
listview {
    scrollbar: true;
    margin: 0 12px 0 18px;
    background-color: transparent;
}

scrollbar {
	  background-color: rgba(50,60,60,0.6);
    handle-color: rgba(50,80,80,1);
    handle-width: 8px;
    border: 0;
    margin: 0 0 0 12px;
    border-radius: 4px;
}

/* ── Elements (rows) ────────────────────────────────────────────────── */
element {
    padding: 8px 10px;
    spacing: 8px;
    border-radius: 6px;
    children: [element-icon, element-text];
}

element normal {
    background-color: transparent;
    text-color: #e0def4; /* main text */
}

element-text {
    text-color: #e0def4;
}

element-text sub {
    text-color: #908caa; /* readable dim comment */
    font-size: 0.9em;
}

element normal active {
    // background-color: rgba(42,39,63,0.7);
    text-color: #000000;
}

/* Active/Selected element */
element selected {
    background-color: rgba(50,70,60,0.9); /* lighter than window background */
    text-color: #000000; /* keep dark text */
}

element selected element-text sub {
    text-color: #000000; /* darker dim on selection */
}

element normal urgent,
element selected urgent {
    text-color: #000000;
}

