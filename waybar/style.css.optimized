/* Waybar Semantic Styling — Grouped Modules */

/* Color Palette (Rose Pine) */
@define-color base #191724;
@define-color surface #1f1d2e;
@define-color overlay #26233a;
@define-color muted #6e6a86;
@define-color subtle #908caa;
@define-color text #e0def4;
@define-color love #eb6f92;
@define-color gold #f6c177;
@define-color rose #ebbcba;
@define-color pine #31748f;
@define-color foam #9ccfd8;
@define-color iris #c4a7e7;

@define-color highlight-low #21202e;
@define-color highlight-med #403d52;
@define-color highlight-high #524f67;

/* Workspace Colors */
@define-color workspace-inactive @muted;
@define-color workspace-active @iris;
@define-color workspace-urgent @love;
@define-color workspace-hover @foam;

/* ─────────────────────────────────────────────────────────── */
/* Global Styling */
/* ─────────────────────────────────────────────────────────── */

* {
  border: none;
  border-radius: 4px;
  font-family: "FiraCode Nerd Font", monospace;
  font-weight: 500;
  font-size: 15px;
  min-height: 0;
}

window#waybar {
  background: rgba(25, 23, 36, 0.75);
  color: @text;
  transition-property: background-color;
  transition-duration: 0.3s;
}

/* ─────────────────────────────────────────────────────────── */
/* Section Grouping */
/* ─────────────────────────────────────────────────────────── */

.modules-left,
.modules-center,
.modules-right {
  padding: 0 8px;
}

/* LEFT SECTION: Navigation */
.modules-left {
  background: transparent;
  spacing: 6px;
}

/* CENTER SECTION: Clock (Primary Focus) */
.modules-center {
  background: transparent;
  flex-grow: 1;
  display: flex;
  justify-content: center;
}

/* RIGHT SECTION: System Info & Controls */
.modules-right {
  background: transparent;
  spacing: 0px;
}

/* ─────────────────────────────────────────────────────────── */
/* Navigation Section (Left) */
/* ─────────────────────────────────────────────────────────── */

#custom-launcher {
  color: @iris;
  font-size: 18px;
  padding: 0 8px;
  margin-right: 8px;
}

#workspaces {
  background: transparent;
  margin-right: 12px;
}

#workspaces button {
  color: @workspace-inactive;
  padding: 0 8px;
  margin: 4px 2px;
  border-radius: 4px;
  transition: all 0.3s ease;
  background: transparent;
}

#workspaces button.active {
  border: 1px solid @iris;
  color: @text;
  font-weight: 600;
  background: rgba(196, 167, 231, 0.1);
}

#workspaces button.urgent {
  background: @workspace-urgent;
  color: @base;
  animation: pulse 2s infinite;
}

#workspaces button:hover {
  background: rgba(156, 207, 216, 0.2);
  color: @workspace-hover;
}

/* ─────────────────────────────────────────────────────────── */
/* Clock Section (Center — Primary Visual Element) */
/* ─────────────────────────────────────────────────────────── */

#clock {
  color: @text;
  font-weight: 600;
  font-size: 16px;
  margin: 0 20px;
  background: transparent;
}

/* ─────────────────────────────────────────────────────────── */
/* System Information Group (Right) */
/* ─────────────────────────────────────────────────────────── */

/* GROUP: System Metrics Container */
#network,
#temperature,
#cpu,
#memory,
#battery {
  background: rgba(50, 45, 60, 0.15);
  border: 1px solid rgba(90, 120, 120, 0.6);
  border-radius: 4px;
  padding: 0 8px;
  margin: 4px 2px;
  transition: all 0.3s ease;
}

/* Hover effect for system metrics */
#network:hover,
#temperature:hover,
#cpu:hover,
#memory:hover,
#battery:hover {
  background: rgba(50, 45, 60, 0.3);
  border-color: rgba(90, 120, 120, 1);
}

/* Module-specific colors */
#network {
  color: @foam;
}

#temperature {
  color: @gold;
}

#cpu {
  color: @rose;
}

#memory {
  color: @iris;
}

/* Battery States */
#battery {
  color: @text;
}

#battery.charging {
  color: @foam;
}

#battery.warning:not(.charging) {
  color: @gold;
}

#battery.critical:not(.charging) {
  color: @love;
}

/* ─────────────────────────────────────────────────────────── */
/* Group Separators */
/* ─────────────────────────────────────────────────────────── */

#custom-group-system-start {
  background: transparent;
  margin-left: 12px;
  padding: 0;
}

#custom-group-system-end {
  background: transparent;
  margin-right: 12px;
  padding: 0;
}

#custom-group-power-start {
  background: transparent;
  margin-left: 12px;
  padding: 0;
}

#custom-group-power-end {
  background: transparent;
  margin-right: 0;
  padding: 0;
}

/* ─────────────────────────────────────────────────────────── */
/* Power Management Section (Right) */
/* ─────────────────────────────────────────────────────────── */

#tray {
  padding: 0 10px;
  margin: 0 4px;
}

#custom-actions {
  color: @love;
  padding: 0 10px;
  cursor: pointer;
  transition: all 0.3s ease;
}

#custom-actions:hover {
  color: @rose;
  background: rgba(235, 111, 146, 0.1);
  border-radius: 4px;
}

#custom-tlp {
  color: @gold;
  padding: 0 8px;
}

/* ─────────────────────────────────────────────────────────── */
/* Animations */
/* ─────────────────────────────────────────────────────────── */

@keyframes pulse {
  0% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
  100% {
    opacity: 1;
  }
}

@keyframes blink-warning {
  to {
    background-color: @gold;
    color: @base;
  }
}

@keyframes blink-critical {
  to {
    background-color: @love;
    color: @text;
  }
}

#battery.warning:not(.charging) {
  animation: blink-warning 1s infinite steps(2);
}

#battery.critical:not(.charging) {
  animation: blink-critical 0.5s infinite steps(2);
}

/* ─────────────────────────────────────────────────────────── */
/* Tooltips */
/* ─────────────────────────────────────────────────────────── */

tooltip {
  background: @base;
  border: 1px solid @highlight-med;
  border-radius: 4px;
  padding: 8px;
  text-shadow: none;
}

tooltip label {
  color: @text;
  font-size: 14px;
}
