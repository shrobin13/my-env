
#!/usr/bin/env bash
# Waybar module: pending package updates + click‑to‑update
# Supports pacman, dnf, apt.  Usage:
#   update-sys          → JSON output for Waybar
#   update-sys update   → opens Kitty/foot/alacritty & runs update

TERM_CMD=${TERMINAL:-kitty}         # change if you prefer foot, alacritty, gnome-terminal…

launch_updater() {
  "$TERM_CMD" -e bash -c '
      set -e
      if command -v pacman &>/dev/null; then
          sudo pacman -Syu
      fi
  ' &
}

if [[ $1 == update ]]; then
  launch_updater
  exit 0
fi

count=0 tooltip="" class="uptodate" icon=""

if command -v checkupdates &>/dev/null; then                    # Arch
    mapfile -t updates < <(checkupdates 2>/dev/null)
    count=${#updates[@]}
    tooltip=$(printf '%s\n' "${updates[@]}")
fi

[[ $count -gt 0 ]] && class="updates" && icon=""

# Shrink tooltip if massive
tooltip=${tooltip:0:500}
[[ ${#tooltip} -ge 500 ]] && tooltip="$tooltip…"

echo "{\"text\":\"$icon ${count:-0}\",\"tooltip\":\"${tooltip}\",\"class\":\"$class\"}"
