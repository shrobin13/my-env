{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 36,
  "spacing": 6,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-right": 1,
  "margin-left": 1,

// LEFT: The "Start" area
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "tray"
  ],

  // CENTER: Focus on status/metrics
  "modules-center": [
    "cpu",
    "memory",
    "temperature",
    "battery"
  ],

  // RIGHT: The "System Tray" area
  "modules-right": [
    "network",
    "custom/power_profile",
    "clock",
    "custom/lock_screen"
  ],
 
  // Custom Modules
  "custom/launcher": {
    "format": "<span font='14'></span>",
    "on-click": "rofi -show drun -theme ~/.config/rofi/rose-pine.rasi",
    "tooltip": false
  },
  "custom/power_profile": {
    "exec": "~/.config/waybar/scripts/power-profile.sh",
    "interval": 10,
    "format": "{} ",
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/power-profile.sh --toggle",
    "tooltip": true,
    "tooltip-format": "Click to cycle power profile"
  },
  "custom/lock_screen": {
    "format": "<span font='14'></span>",
    "on-click": "swaync-client -t",
    "tooltip": false
  },
  // Workspaces
  "hyprland/workspaces": {
    "on-click": "activate",
    "disable-scroll": true,
    "all-outputs": true,
    "show-special": true,
    "format": "{name}",
    "format-icons": {
      "urgent": "<span foreground='#e06c75'>[!]</span>",
      "default": "<span foreground='#888888'>[·]</span>"
    },
    "format-workspace": "<span foreground='{color}'>[{name}]</span>",
    "color": {
      "active": "#61afef",
      "inactive": "#888888"
    },
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4
      ]
    }
  },
  // Tray
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },
  // CPU Monitor
  "cpu": {
    "interval": 1,
    "format": "🖳 {usage}% {icon0}{icon1}{icon2}{icon3}{icon4}{icon5}{icon6}{icon7}",
    "max-length": 16,
    "tooltip": false,
    "format-icons": [
      "<span color='#31748f'>▁</span>", // pine green (very low usage)
      "<span color='#4c566a'>▂</span>", // moon gray (low usage)
      "<span color='#c4a7e7'>▃</span>", // iris purple (moderate low)
      "<span color='#ebbcba'>▄</span>", // flamingo pink (moderate)
      "<span color='#f6c177'>▅</span>", // gold (moderate-high)
      "<span color='#f6c177'>▆</span>", // gold (high)
      "<span color='#eb6f92'>▇</span>", // rose pink (very high)
      "<span color='#b4637a'>█</span>" // wine red (max usage)
    ]
  },
  "temperature": {
    "thermal-zone": 6,
    "interval": 1,
    "format": "<span color='#f6c177'></span> {temperatureC}°C",
    "format-alt": "<span color='#31748f'></span>",
    "critical-threshold": 70,
    "format-critical": "<span color='#eb6f92'></span> {temperatureC}°C",
    "on-click": "kitty --hold ~/.config/waybar/scripts/show-temps.sh",
    "tooltip": false
  },
  "memory": {
    "format": "🖫 {percentage}%",
    "max-length": 6,
    "on-click": "kitty -e htop"
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-alt": "{icon}",
    "format-charging": "<span color='#31748f'> {capacity}%</span>",
    "format-plugged": "<span color='#4c566a'> {capacity}%</span>",
    "format-full": "<span color='#f6c177'> {capacity}%</span>",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-icons": [
      "<span color='#b4637a'></span>", // empty wine red
      "<span color='#eb6f92'></span>", // low rose pink
      "<span color='#f6c177'></span>", // medium gold
      "<span color='#31748f'></span>", // good pine green
      "<span color='#286983'></span>" // full teal-ish green
    ],
    "on-click": "kitty -e sh -c 'upower -i /org/freedesktop/UPower/devices/battery_BAT0; echo Press ENTER to close...; read'",
    "tooltip": false
  },
  // Network
  "network": {
    "interval": 2,
    "interface": "wlan0",
    "format-wifi": "   ↓{bandwidthDownBytes} ↑{bandwidthUpBytes} ",
    "format-wifi-alt": "  {essid} ",
    "format-ethernet": " {ifname} ",
    "format-disconnected": "  ",
    "tooltip-format-wifi": "SSID: {essid}\nDown: {bandwidthDownBytes} B/s\nUp: {bandwidthUpBytes} B/s",
    "tooltip-format-ethernet": "{ifname} {ipaddr}/{cidr}",
    "on-click": "kitty -e nmtui"
  },
  // Clock
  "clock": {
    "timezone": "Asia/Dhaka",
    "format": " {:%I:%M%p}",
    "format-alt": " {:%Y-%m-%d}",
    "tooltip": true,
    "tooltip-format": "{:%A, %B %e %Y}"
  }
}
