# ==================================================
# Hyprland General Configuration — Optimized
# ==================================================

general {
    # ─ Window Decorations & Layout ─
    gaps_in = 5                     # Gaps between windows
    gaps_out = 5                    # Gaps at screen edges
    border_size = 1

    # Border Colors with Gradient
    col.active_border = rgba(90,120,120,1) rgba(90,120,120,0.8) 45deg
    col.inactive_border = rgba(110,106,134,0.5)

    # Layout Engine
    layout = dwindle                # Tiling layout (dwindle = balanced binary space partition)

    # ─ Mouse Interaction ─
    resize_on_border = false        # Don't resize by dragging edge
    allow_tearing = false           # Disable VRR tearing (unless needed)

    # ─ Window Behavior ─
    float_override_layout = 2       # Floats maintain tiling behavior
    no_focus_fallback = false       # Focus new windows if possible
    center_new_windows = false      # Don't auto-center floating windows

    # ─ Focus Following ─
    focus_follows_mouse = 1         # Focus follows cursor (0=off, 1=focus, 2=focus+raise)

    # ─ Workspace Cycling (NEW) ─
    focus_to_other_workspaces = true    # Alt+Tab cycles ALL workspaces
    allow_workspace_cycles = true       # Mouse wheel wraps at edges

    # ─ VRR (Variable Refresh Rate) ─
    vrr = 1                         # Enable adaptive sync if available

    # ─ Frame Pacing ─
    # These help with frame consistency on multi-monitor setups
    smart_resizing = true           # Better resize performance

    # ─ Color Management (Future-proofing) ─
    # Enable if using HDR displays (Hyprland 0.41+)
    # hdr = true
}
