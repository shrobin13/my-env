# ==================================================
# Hyprland Enhanced Input Configuration
# ==================================================

# ─────────────────────────────────────────────────────────
# KEYBOARD CONFIGURATION
# ─────────────────────────────────────────────────────────

input {
  # Layout & Modifiers
  kb_layout = us
  kb_options = caps:swapescape                 # Swap Caps Lock with Escape (Vim workflow)
  kb_options = compose:rwin                    # Right Windows key = Compose key (special chars)

  # Key Repeat (for terminal/editor rapid typing)
  kb_repeat_delay = 200                        # Delay before repeat (ms)
  kb_repeat_rate = 50                          # Repeat rate (chars/sec)

  # Number Lock
  numlock_by_default = true
}

# ─────────────────────────────────────────────────────────
# TOUCHPAD CONFIGURATION
# ─────────────────────────────────────────────────────────

input {
  touchpad {
    # Scroll Behavior
    natural_scroll = true                      # Reverse scroll direction (macOS-like)
    scroll_factor = 1.0

    # Click Behavior
    tap_button_map = lmr                       # Left tap=LMB, right tap=RMB, middle tap=MMB
    clickfinger_behavior = false                # Enable tap-to-click (false = enabled)
    click_method = clickfinger                 # Method: clickfinger or button areas

    # Advanced Features
    disable_while_typing = true                # NEW: Prevent accidental clicks while typing
    drag_lock = true                           # Hold tap for drag (standard behavior)
    middle_button_emulation = true             # 3-finger tap = middle click

    # Sensitivity & Speed
    pointer_accel = 0.0                        # No acceleration on touchpad
  }
}

# ─────────────────────────────────────────────────────────
# MOUSE CONFIGURATION
# ─────────────────────────────────────────────────────────

device {
  name = epic-mouse-v1                         # Device name from `hyprctl devices`

  # Sensitivity (range: -1.0 to 1.0)
  # Negative = slower, Positive = faster
  sensitivity = -0.5                           # Balanced sensitivity

  # Acceleration Profile
  # 'flat' = no acceleration, 'adaptive' = varies with speed
  accel_profile = adaptive

  # Polling Rate (Hz)
  # 1000 = every 1ms, 125 = every 8ms
  # 1000 is gaming-grade but may drain power
  # Recommended for laptop: 125-500
  poll_rate_hz = 500                           # Mid-range for balance
}

# ─────────────────────────────────────────────────────────
# ALTERNATIVE: CREATE MULTIPLE PROFILES
# ─────────────────────────────────────────────────────────

# You can define multiple device sections for the same hardware
# Then activate via script or window rules

# device {
#   name = epic-mouse-v1
#   sensitivity = -0.8                        # Precision mode (slower)
#   accel_profile = flat                      # No acceleration
# }

# device {
#   name = epic-mouse-v1-gaming
#   sensitivity = 0.2                         # Gaming mode (faster)
#   accel_profile = adaptive
#   poll_rate_hz = 1000
# }

# ─────────────────────────────────────────────────────────
# CURSOR CONFIGURATION
# ─────────────────────────────────────────────────────────

general {
  # Mouse behavior when window is floated
  float_override_layout = 2                    # 2 = keep tiling behavior for floats
}

# ─────────────────────────────────────────────────────────
# NOTES ON DEVICE DISCOVERY
# ─────────────────────────────────────────────────────────
# To find your device names, run:
#   hyprctl devices
#
# Example output:
#   Device: epic-mouse-v1
#   Type: mouse
#   Enabled: true
#   Drivers: libinput
#   Speed: -0.5
#   ...
#
# Use exact device name in the 'name' field above
