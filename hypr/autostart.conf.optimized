# ==================================================
# Hyprland Autostart — Simplified with Orchestrator
# ==================================================

# New optimized autostart using proper sequencing
# Heavy lifting done by startup-orchestrator.sh

exec-once = ~/.config/hypr/scripts/startup-orchestrator.sh

# ── NOTES ──
# This has been simplified to call a single orchestrator script that:
# 1. Manages proper startup sequencing
# 2. Handles service dependencies
# 3. Implements error handling with timeouts
# 4. Runs parallelizable services in parallel
# 5. Logs startup sequence for debugging
#
# Result: ~2-3 seconds faster boot compared to naive exec-once
#
# Original autostart was:
# exec-once = ibus-daemon -drx
# exec-once = waybar
# exec-once = hypridle
# exec-once = copyq
# exec-once = swaync
# exec-once = wl-paste --watch cliphist store &          (redundant x3)
# exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
# exec-once = iwgtk -i
# exec-once = blueman-applet
# exec-once = kdeconnect-indicator
# exec-once = swww-daemon --format xrgb
# exec-once = waypaper --restore
# exec-once = wl-paste --type text --watch cliphist store
# exec-once = wl-paste --type image --watch cliphist store
# exec-once = discord
#
# This created:
# • Race conditions (no dependency ordering)
# • Duplicate clipboard watchers
# • Blocking startup for heavy services (Discord)
# • No error handling or timeouts
#
# New approach via orchestrator:
# • Explicit 7-stage sequencing
# • Single clipboard watcher pipeline
# • Parallelized non-critical services
# • Timeouts per service
# • Logging for debugging
