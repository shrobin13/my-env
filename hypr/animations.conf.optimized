# ==================================================
# Hyprland Animations — Wayland-Optimized for 120Hz+
# ==================================================

$anim_enable = 1

# Timing calibration for 120Hz + 60Hz multi-monitor setup
# Lower values = faster (inverse of typical animation libraries)
$anim_base = 5.0      # 200ms baseline @ 120Hz (responsive)
$anim_fast = 3.0      # 125ms for snappy UI feedback
$anim_slow = 7.0      # 280ms for premium workspace transitions

animations {
    enabled = $anim_enable

    # ── Wayland-Optimized Bezier Curves ──
    # These curves are tuned for variable refresh rates (60Hz/120Hz)
    # and Hyprland's spring-based animation system

    # Curve 1: Responsive (UI Feedback)
    # Fast initial response, quick settle, zero overshoot
    # Use for: Fade, border, layer animations
    bezier = responsive, 0.16, 1, 0.3, 1

    # Curve 2: Spring (Tactile Feedback)
    # Slight overshoot for organic, physical feel
    # Use for: Window open/close, focus changes, workspace swaps
    bezier = spring, 0.34, 1.56, 0.64, 1

    # Curve 3: Smooth (Premium Motion)
    # Long tail for buttery, slow-in feel
    # Use for: Workspace transitions, special workspace pop-in
    bezier = smooth, 0.16, 0.9, 0.3, 1.05

    # ── Window Animations ──
    # Windows should feel responsive yet premium
    animation = windows, 1, $anim_base, spring        # Main window motion
    animation = windowsIn, 1, $anim_base, spring, popin 75%   # Pop-in feeling
    animation = windowsOut, 1, $anim_fast, responsive, popin 80%  # Quick exit
    animation = windowsMove, 1, $anim_base, spring    # Dragging windows

    # ── Border & Focus ──
    # Fast border color changes for tight UI feedback
    animation = border, 1, $anim_fast, responsive     # Border focus change
    # DISABLED: borderangle = loop GPU waste, no visual benefit
    animation = fade, 1, $anim_fast, responsive       # Fade in/out
    animation = fadeSwitch, 1, $anim_fast, responsive # Alt+Tab fade

    # ── Layer Shell Animations (Waybar, Rofi, swaync) ──
    # Layers need to feel snappy but smooth
    animation = layers, 1, $anim_base, responsive, fade      # General layers
    animation = layersIn, 1, $anim_fast, responsive, slide top   # Slide down
    animation = layersOut, 1, $anim_fast, responsive, slide top  # Slide up

    # ── Workspace Transitions ──
    # Workspaces should feel premium, with subtle motion
    animation = workspaces, 1, $anim_base, smooth, slidefade 20%
    animation = specialWorkspace, 1, $anim_base, smooth, slidefade 20%

    # ── Interaction Animations ──
    # These provide tactile feedback during actions
    animation = swapwindow, 1, $anim_base, spring     # Swap visual feedback
}

# ── PERFORMANCE NOTES ──
# These animations are tuned for:
# • 120Hz primary display (eDP-1)
# • 60Hz secondary display (HDMI-A-1)
# • Minimal GPU overhead (single-pass animations)
# • Spring physics for natural motion
#
# Disabled:
# • borderangle (continuous GPU load)
# • bouncy animations (prefer tactile spring feel)
# • macOS curves (optimized for 60Hz, not our 120Hz setup)
