{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 13,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 14,
  "control-center-margin-left": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 28,
  "notification-body-image-height": 110,
  "notification-body-image-width": 110,
  "notification-window-width": 320,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "control-center-width": 380,
  "control-center-height": 900,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "dnd",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "label": {
      "max-lines": 1,
      "text": "Notification"
    },
    "mpris": {
      "image-size": 56,
      "image-radius": 4
    },
    "volume": {
      "label": "󰕾",
      "icon-size": 22
    },
    "backlight": {
      "label": "󰃟",
      "icon-size": 22
    },
    "buttons-grid": {
      "icon-size": 28,
      "button-size": 48,
      "actions": [
        {
          "label": "󰂯",
          "command": "blueman-manager && swaync-client -rs"
        },
        {
          "label": "",
          "command": "hyprlock"
        },
        {
          "label": "󰜉",
          "command": "systemctl reboot && swaync-client -rs"
        },
        {
          "label": "",
          "command": "systemctl poweroff && swaync-client -rs"
        }
      ]
    }
  }
}
