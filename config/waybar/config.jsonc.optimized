{
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 36,
  "spacing": 0,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-right": 1,
  "margin-left": 1,

  // ── LEFT: Navigation & Launcher ──
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],

  // ── CENTER: Time (Primary Focus) ──
  "modules-center": [
    "clock"
  ],

  // ── RIGHT: System Information ──
  "modules-right": [
    "custom/group-system-start",
    "network",
    "temperature",
    "cpu",
    "memory",
    "battery",
    "custom/group-system-end",
    "custom/group-power-start",
    "tray",
    "custom/actions",
    "custom/group-power-end"
  ],

  // ──────────────────────────────────────────────────────────
  // CUSTOM MODULES
  // ──────────────────────────────────────────────────────────

  "custom/launcher": {
    "format": "<span font='14'></span>",
    "on-click": "rofi -show drun -theme ~/.config/rofi/rose-pine.rasi",
    "tooltip": false,
    "tooltip-format": "Application Launcher"
  },

  "custom/group-system-start": {
    "format": "",
    "tooltip": false
  },

  "custom/group-system-end": {
    "format": "",
    "tooltip": false
  },

  "custom/group-power-start": {
    "format": "",
    "tooltip": false
  },

  "custom/group-power-end": {
    "format": "",
    "tooltip": false
  },

  "custom/actions": {
    "format": "<span font='12'>  </span>",
    "on-click": "swaync-client -t",
    "tooltip": false,
    "tooltip-format": "Notifications & System"
  },

  // ──────────────────────────────────────────────────────────
  // NAVIGATION
  // ──────────────────────────────────────────────────────────

  "hyprland/workspaces": {
    "on-click": "activate",
    "disable-scroll": true,
    "all-outputs": true,
    "show-special": true,
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5, 6]
    }
  },

  // ──────────────────────────────────────────────────────────
  // TIME (Center Focus)
  // ──────────────────────────────────────────────────────────

  "clock": {
    "timezone": "Asia/Dhaka",
    "format": " {:%I:%M%p}",
    "format-alt": " {:%Y-%m-%d}",
    "tooltip": true,
    "tooltip-format": "{:%A, %B %e, %Y}"
  },

  // ──────────────────────────────────────────────────────────
  // SYSTEM INFORMATION (Right Section)
  // ──────────────────────────────────────────────────────────

  "network": {
    "interval": 2,
    "format-wifi": " {essid}",
    "format-ethernet": " {ifname}",
    "format-disconnected": " Offline",
    "tooltip-format-wifi": "{essid}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname} {ipaddr}/{cidr}",
    "on-click": "kitty -e nmtui"
  },

  "temperature": {
    "thermal-zone": 6,
    "interval": 1,
    "format": " {temperatureC}°C",
    "critical-threshold": 70,
    "tooltip": false,
    "states": {
      "warning": 60,
      "critical": 70
    },
    "on-click": "kitty -e watch -n 1 sensors"
  },

  "cpu": {
    "interval": 1,
    "format": "  {usage}%",
    "tooltip": "{load}",
    "states": {
      "warning": 50,
      "critical": 80
    },
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 2,
    "format": " {percentage}%",
    "tooltip": "{used}GB / {total}GB",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "kitty -e htop"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": " {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip": "{timeTo}",
    "on-click": "kitty -e upower -i /org/freedesktop/UPower/devices/battery_BAT0"
  },

  // ──────────────────────────────────────────────────────────
  // POWER MANAGEMENT
  // ──────────────────────────────────────────────────────────

  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "show-passive-items": true
  },

  "custom/tlp": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/power-profile.sh",
    "on-click": "~/.config/waybar/scripts/power-profile.sh --toggle",
    "interval": 30,
    "signal": 4
  }
}
