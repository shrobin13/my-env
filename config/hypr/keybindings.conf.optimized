# ==================================================
# Hyprland Enhanced Keybindings — Optimized Workflow
# ==================================================

$mainMod = SUPER

# ─────────────────────────────────────────────────────────
# APPLICATION LAUNCHING
# ─────────────────────────────────────────────────────────

bind = $mainMod, Return, exec, $terminal           # Terminal
bind = $mainMod, E, exec, $fileManager             # File manager
bind = $mainMod, SPACE, exec, $menu                # Application launcher
bind = $mainMod, B, exec, $browser                 # Browser

# ─────────────────────────────────────────────────────────
# WINDOW MANAGEMENT — MOVEMENT & STATE
# ─────────────────────────────────────────────────────────

# Kill/Close Active Window
bind = $mainMod, Q, killactive                     # Kill active window
bind = $mainMod SHIFT, Q, exec, hyprctl activewindow | grep pid | tr -d 'pid:' | xargs kill  # Force quit

# Window Fullscreen/Maximize
bind = $mainMod, F, fullscreen, 0                  # Fullscreen (no scaling)
bind = $mainMod, M, fullscreen, 1                  # Maximize (scale to fit)

# Floating/Tiling Toggle
bind = $mainMod, T, togglefloating                 # Toggle floating for active window
bind = $mainMod SHIFT, T, workspaceopt, allfloat   # Toggle all windows floating

# ─────────────────────────────────────────────────────────
# FOCUS NAVIGATION — Vim Keys
# ─────────────────────────────────────────────────────────

bind = $mainMod, h, movefocus, l                   # Focus left
bind = $mainMod, l, movefocus, r                   # Focus right
bind = $mainMod, k, movefocus, u                   # Focus up
bind = $mainMod, j, movefocus, d                   # Focus down

# Arrow key alternatives
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

# NEW: Tab cycling with focus wrapping
bind = $mainMod, Tab, movefocus, next              # Cycle to next window
bind = $mainMod SHIFT, Tab, movefocus, prev        # Cycle to previous window

# ─────────────────────────────────────────────────────────
# WINDOW RESIZING — Keyboard
# ─────────────────────────────────────────────────────────

bind = $mainMod SHIFT, l, resizeactive, 100 0      # Increase width
bind = $mainMod SHIFT, h, resizeactive, -100 0     # Decrease width
bind = $mainMod SHIFT, j, resizeactive, 0 100      # Increase height
bind = $mainMod SHIFT, k, resizeactive, 0 -100     # Decrease height

# ─────────────────────────────────────────────────────────
# WINDOW SWAPPING — Alt+hjkl
# ─────────────────────────────────────────────────────────

bind = $mainMod ALT, h, swapwindow, l              # Swap with left
bind = $mainMod ALT, l, swapwindow, r              # Swap with right
bind = $mainMod ALT, k, swapwindow, u              # Swap with up
bind = $mainMod ALT, j, swapwindow, d              # Swap with down

# ─────────────────────────────────────────────────────────
# WINDOW GROUPING
# ─────────────────────────────────────────────────────────

bind = $mainMod, G, togglegroup                    # Toggle group mode
bind = $mainMod SHIFT, G, moveoutofgroup           # Move window out of group

# ─────────────────────────────────────────────────────────
# LAYOUT CONTROL
# ─────────────────────────────────────────────────────────

bind = $mainMod, Y, layoutmsg, togglesplit         # Toggle split orientation
bind = $mainMod SHIFT, Y, layoutmsg, swapsplit     # Swap split with neighbor

# ─────────────────────────────────────────────────────────
# WORKSPACE NAVIGATION
# ─────────────────────────────────────────────────────────

# Number keys: Switch workspaces
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# Workspace Cycling (NEW)
bind = $mainMod CTRL, left, workspace, e-1        # Previous workspace
bind = $mainMod CTRL, right, workspace, e+1       # Next workspace

# ─────────────────────────────────────────────────────────
# MOVE WINDOW TO WORKSPACE
# ─────────────────────────────────────────────────────────

bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# ─────────────────────────────────────────────────────────
# SCRATCHPAD (Special Workspace)
# ─────────────────────────────────────────────────────────

bind = $mainMod, S, togglespecialworkspace, magic          # Toggle scratchpad
bind = $mainMod SHIFT, S, movetoworkspace, special:magic   # Move to scratchpad

# ─────────────────────────────────────────────────────────
# WORKSPACE SCROLLING (Mouse)
# ─────────────────────────────────────────────────────────

bind = $mainMod, mouse_down, workspace, e+1              # Scroll down: next workspace
bind = $mainMod, mouse_up, workspace, e-1                # Scroll up: previous workspace

# ─────────────────────────────────────────────────────────
# MOUSE WINDOW MANIPULATION
# ─────────────────────────────────────────────────────────

bindm = $mainMod, mouse:272, movewindow                   # Left-click drag: move window
bindm = $mainMod, mouse:273, resizewindow                 # Right-click drag: resize window

# ─────────────────────────────────────────────────────────
# SESSION & POWER MANAGEMENT
# ─────────────────────────────────────────────────────────

bind = $mainMod SHIFT, x, exit                            # Exit Hyprland
bind = $mainMod, x, exec, ~/.config/hypr/scripts/hyprlock.sh  # Lock screen

# ─────────────────────────────────────────────────────────
# SCREENSHOT & CLIPBOARD
# ─────────────────────────────────────────────────────────

bind = $mainMod, Print, exec, bash -c 'grim -g "$(slurp)" $HOME/Pictures/Screenshots/screenshot_$(date +%Y-%m-%d_%H-%M-%S).png'

# Clipboard History
bind = $mainMod, V, exec, $HOME/.config/hypr/scripts/cliphist.sh

# Window Switcher (Alt+Tab style)
bind = ALT, R, exec, rofi -show window -theme "$HOME/.config/rofi/rose-pine.rasi"

# ─────────────────────────────────────────────────────────
# MULTIMEDIA KEYS — Laptop Function Keys
# ─────────────────────────────────────────────────────────

# Volume Control (XF86Audio*)
bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = , XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Brightness Control (XF86MonBrightness*)
bindel = , XF86MonBrightnessUp, exec, brightnessctl -e4 -n2 set 5%+
bindel = , XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 5%-

# Media Playback (playerctl)
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPrev, exec, playerctl previous

# Calculator
bind = , XF86Calculator, exec, gnome-calculator

# ─────────────────────────────────────────────────────────
# ALT+TAB WINDOW CYCLING (Advanced)
# ─────────────────────────────────────────────────────────

# Continuous cycling: Press Alt+Tab to move to next window
# The `binde` (repeat key) makes this smooth for rapid switching
binde = ALT, Tab, cyclenext                             # Cycle to next window
binde = ALT, Tab, bringactivetotop                      # Bring to top during cycle

binde = ALT SHIFT, Tab, cyclenext, prev                 # Reverse cycle with Shift
binde = ALT SHIFT, Tab, bringactivetotop

# ─────────────────────────────────────────────────────────
# MONITOR FOCUS NAVIGATION (Multi-Monitor)
# ─────────────────────────────────────────────────────────

# NEW: Switch focus between monitors (if multi-monitor setup)
# (Requires monitor-specific workspace setup in monitors.conf)
# bind = $mainMod CTRL, period, focusmonitor, +1         # Focus next monitor
# bind = $mainMod CTRL, comma, focusmonitor, -1          # Focus prev monitor

# ─────────────────────────────────────────────────────────
# NOTES
# ─────────────────────────────────────────────────────────
# • bind = key bound to normal keypress
# • bindl = key bound but locked (low-level, ignores keygrab)
# • binde = key can repeat while held (for smooth interactions)
# • bindm = mouse binding
#
# Modifiers:
# • $mainMod = SUPER (Windows key)
# • ALT, SHIFT, CTRL = standard modifiers
# • Can combine: $mainMod SHIFT, key
#
# Direction arguments: l (left), r (right), u (up), d (down)
#
# NEW in optimized version:
# • Added Tab-based focus cycling with wrapping
# • Added workspace cycling with Ctrl+arrows
# • Added Alt+Tab window switcher improvements
# • Organized into semantic sections for maintainability
